# UltraSwarm Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Configuration (Required)
# =============================================================================

# Google Gemini API (Cloud) - Required if not using local LLM
GOOGLE_API_KEY=your_google_api_key_here

# LLM Model (optional)
GEMINI_MODEL=gemini-2.5-flash

# Local LLM (optional - uncomment if using LM Studio/Ollama)
# USE_LOCAL_LLM=true
# LOCAL_LLM_URL=http://host.docker.internal:1234/v1
# LOCAL_MODEL_NAME=liquid/lfm2.5-1.2b
# LOCAL_LLM_API_KEY=lm-studio

# =============================================================================
# Browser Configuration
# =============================================================================

# Headless mode (true = no browser UI, false = visible browser)
BROWSER_HEADLESS=true

# Auto-start browser on startup
BROWSER_USE_AUTO_START=true

# Use browser-use cloud service (alternative to local browser)
BROWSER_USE_CLOUD=false

# Chrome DevTools Protocol port
BROWSER_USE_CDP_PORT=9222

# Custom Chrome executable path (optional)
# BROWSER_USE_CHROME_PATH=/usr/bin/chromium

# =============================================================================
# Playwright Configuration (Arch Linux & Container Support)
# =============================================================================

# Skip system library validation (required for Arch Linux)
PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1

# Playwright browser location
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# =============================================================================
# Agent Configuration
# =============================================================================

# Maximum tokens for LLM responses
MAX_TOKENS=8192

# LLM temperature (0.0 = deterministic, 1.0 = creative)
AGENT_TEMPERATURE=0.7

# Minimum seconds between Gemini API requests
GEMINI_MIN_SECONDS_BETWEEN_REQUESTS=4

# =============================================================================
# Store Configuration (Optional)
# =============================================================================

# Store URL (for e-commerce agents)
STORE_URL=

# Store Niche/Category (for e-commerce agents)
STORE_NICHE=

# =============================================================================
# Browser Runtime Configuration
# =============================================================================

# CDP startup timeout (seconds)
BROWSER_USE_CDP_STARTUP_TIMEOUT=30

# User data directory for browser profile (optional)
# BROWSER_USE_USER_DATA_DIR=/path/to/custom/profile

# =============================================================================
# Testing Configuration (Optional)
# =============================================================================

# Enable browser debugging
AGENT_BROWSER_DEBUG=false

# Max planner loop steps for browser operations
BROWSER_OPERATOR_MAX_STEPS=8
